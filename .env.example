# Qwen / Alibaba Cloud Model Studio
# Keep the real API key in .env.local; never commit it.
QWEN_API_KEY=
# OpenAI-compatible base URL, not the /chat/completions path itself.
# Example Singapore workspace URL:
# https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=
# Use a model enabled in your Model Studio workspace, e.g. qwen-plus.
QWEN_MODEL=qwen-plus

# OpenRouter chat assistant
# Keep the real key in .env.local; never use a VITE_ prefix for secrets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_SITE_URL=http://localhost:5173
